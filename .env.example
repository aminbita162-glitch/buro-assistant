# Buro Assistant – environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/buro

# OpenAI API key (required for model routes)
OPENAI_API_KEY=sk-...

# Bind port for the server
PORT=8000

# Comma-separated list of allowed CORS origins (leave empty to deny all cross-origin requests)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Payment gateway secret (Commercial Phase 2).
# When this variable is absent or empty the fake adapter is used and the app still runs.
# When set, the live adapter is activated.  Read from environment only; never stored in code.
# No card data is stored.  No Stripe key and no private URL belongs in this file.
# GATEWAY_SECRET=
