# Buro Assistant – environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/buro

# OpenAI API key (required for model routes)
OPENAI_API_KEY=sk-...

# Bind port for the server
PORT=8000

# Comma-separated list of allowed CORS origins (leave empty to deny all cross-origin requests)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
